      <bpmndi:BPMNShape id="sanctionsPolicyHold_di" bpmnElement="sanctionsPolicyHold">
        <dc:Bounds x="632" y="470" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sanctionsEnd_di" bpmnElement="sanctionsEnd">
        <dc:Bounds x="1092" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1138" y="326.5" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sanctionsStartFlow_di" bpmnElement="sanctionsStartFlow">
        <di:waypoint x="248" y="238" />
        <di:waypoint x="312" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowSanctionsRequestGateway_di" bpmnElement="flowSanctionsRequestGateway">
