      <bpmndi:BPMNEdge id="flowSanctionsRequestPublished_di" bp<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" exporter="Camunda Modeler" exporterVersion="5.48.0" id="transferDefinitions" name="Token transfer workflows" targetNamespace="https://generalcontracts.ai/workflows">
    <bpmn:message id="kycResultMessage" name="KycScreeningResult">
            
        <bpmn:extensionElements>
            <zeebe:subscription correlationKey="=kycScreeningRequestId"/>
        </bpmn:extensionElements>
          
    </bpmn:message>
    <bpmn:process id="kyc-screening-process" isExecutable="true" name="KYC screening">
        <bpmn:documentation>Contract v1.0.0. Inputs: instructionId. Outputs: kycRequestReady, kycNotRequired, kycScreeningRequestIds. Outcome codes: APPROVED, REJECTED, MANUAL_REVIEW, RESTRICTED, ERROR, TIMED_OUT, HOLD. The instruction-keyed persisted screening requests and results are authoritative; timeout, missing, and exhausted technical outcomes remain fail-closed. Correlation is preserved by the declared screening message subscription. Deploy compatible revisions under this stable process ID and use Camunda's process version.</bpmn:documentation>
        <bpmn:startEvent id="kycStart" name="Start KYC screening"/>
        <bpmn:serviceTask id="requestKyc" name="Request KYC screening">
            <bpmn:extensionElements>
                      <zeebe:taskDefinition retries="3" type="screening-request-kyc"/>
                </bpmn:extensionElements>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway default="flowKycPolicyHold" id="kycRequestGateway" name="KYC request published?"/>
        <bpmn:serviceTask id="kycPolicyHold" name="Persist missing KYC policy hold">
            <bpmn:extensionElements>
                      <zeebe:taskDefinition retries="3" type="screening-timeout-kyc"/>
                </bpmn:extensionElements>
        </bpmn:serviceTask>
        <bpmn:subProcess id="kycScreeningRequests" name="Await every required KYC subject">
            <bpmn:multiInstanceLoopCharacteristics>
                      <bpmn:extensionElements>
                                <zeebe:loopCharacteristics inputCollection="=kycScreeningRequestIds" inputElement="kycScreeningRequestId"/>
                          </bpmn:extensionElements>
                </bpmn:multiInstanceLoopCharacteristics>
            <bpmn:startEvent id="kycSubjectWaitStart" name="Wait for subject result"/>
            <bpmn:eventBasedGateway id="kycSubjectWait" name="Await KYC result or timeout"/>
            <bpmn:intermediateCatchEvent id="kycResult" name="KYC subject result">
                      <bpmn:messageEventDefinition messageRef="kycResultMessage"/>
                </bpmn:intermediateCatchEvent>
            <bpmn:intermediateCatchEvent id="kycTimeout" name="KYC subject timeout">
                      <bpmn:timerEventDefinition>
                                <bpmn:timeDuration>PT15M</bpmn:timeDuration>
                          </bpmn:timerEventDefinition>
                </bpmn:intermediateCatchEvent>
            <bpmn:serviceTask id="kycTimeoutPersist" name="Persist KYC subject timeout hold">
                      <bpmn:extensionElements>
                                <zeebe:taskDefinition retries="3" type="screening-timeout-kyc"/>
                                <zeebe:ioMapping>
                                          <zeebe:input source="=instructionId" target="instructionId"/>
                                          <zeebe:input source="=kycScreeningRequestId" target="screeningRequestId"/>
                                    </zeebe:ioMapping>
                          </bpmn:extensionElements>
                </bpmn:serviceTask>
            <bpmn:endEvent id="kycSubjectComplete" name="KYC subject completed"/>
            <bpmn:sequenceFlow id="flowKycSubjectStart" sourceRef="kycSubjectWaitStart" targetRef="kycSubjectWait"/>
            <bpmn:sequenceFlow id="flowKycSubjectResult" sourceRef="kycSubjectWait" targetRef="kycResult"/>
            <bpmn:sequenceFlow id="flowKycSubjectTimeout" sourceRef="kycSubjectWait" targetRef="kycTimeout"/>
            <bpmn:sequenceFlow id="flowKycSubjectResultComplete" sourceRef="kycResult" targetRef="kycSubjectComplete"/>
            <bpmn:sequenceFlow id="flowKycSubjectPersistTimeout" sourceRef="kycTimeout" targetRef="kycTimeoutPersist"/>
            <bpmn:sequenceFlow id="flowKycSubjectTimeoutComplete" sourceRef="kycTimeoutPersist" targetRef="kycSubjectComplete"/>
        </bpmn:subProcess>
        <bpmn:sequenceFlow id="kycStartFlow" sourceRef="kycStart" targetRef="requestKyc"/>
        <bpmn:sequenceFlow id="flowKycRequestGateway" sourceRef="requestKyc" targetRef="kycRequestGateway"/>
        <bpmn:sequenceFlow id="flowKycRequestPublished" sourceRef="kycRequestGateway" targetRef="kycScreeningRequests">
            <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=kycRequestReady = true and kycNotRequired != true</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flowKycNotRequired" sourceRef="kycRequestGateway" targetRef="kycEnd">
            <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=kycNotRequired = true</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flowKycPolicyHold" sourceRef="kycRequestGateway" targetRef="kycPolicyHold">
            <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=kycRequestReady = false</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flowKycPolicyHoldJoin" sourceRef="kycPolicyHold" targetRef="kycEnd"/>
        <bpmn:sequenceFlow id="flowKycRequestsJoin" sourceRef="kycScreeningRequests" targetRef="kycEnd"/>
        <bpmn:endEvent id="kycEnd" name="KYC outcome persisted"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_kyc-screening-process">
        <bpmndi:BPMNPlane bpmnElement="kyc-screening-process" id="BPMNPlane_kyc-screening-process">
