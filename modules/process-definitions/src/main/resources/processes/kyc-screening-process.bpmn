      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycTimeoutPersist_di" bpmnElement="kycTimeoutPersist">
        <dc:Bounds x="930" y="340" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycSubjectComplete_di" bpmnElement="kycSubjectComplete">
        <dc:Bounds x="1152" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1140" y="328" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flowKycSubjectStart_di" bpmnElement="flowKycSubjectStart">
        <di:waypoint x="668" y="310" />
        <di:waypoint x="705" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowKycSubjectResult_di" bpmnElement="flowKycSubjectResult">
        <di:waypoint x="730" y="285" />
        <di:waypoint x="730" y="240" />
        <di:waypoint x="832" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowKycSubjectTimeout_di" bpmnElement="flowKycSubjectTimeout">
        <di:waypoint x="730" y="335" />
        <di:waypoint x="730" y="380" />
