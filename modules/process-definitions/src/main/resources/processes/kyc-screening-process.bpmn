          <dc:Bounds x="204" y="328" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="requestKyc_di" bpmnElement="requestKyc">
        <dc:Bounds x="310" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycRequestGateway_di" bpmnElement="kycRequestGateway" isMarkerVisible="true">
        <dc:Bounds x="475" y="285" width="50" height="50" />
