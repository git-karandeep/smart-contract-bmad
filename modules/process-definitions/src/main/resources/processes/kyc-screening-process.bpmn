          <dc:Bounds x="469" y="335" width="63" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycPolicyHold_di" bpmnElement="kycPolicyHold">
        <dc:Bounds x="650" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycEnd_di" bpmnElement="kycEnd">
        <dc:Bounds x="1292" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1338" y="286.5" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycScreeningRequests_di" bpmnElement="kycScreeningRequests" isExpanded="true">
        <dc:Bounds x="610" y="190" width="640" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycSubjectWaitStart_di" bpmnElement="kycSubjectWaitStart">
        <dc:Bounds x="632" y="292" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="612" y="328" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycSubjectWait_di" bpmnElement="kycSubjectWait">
        <dc:Bounds x="705" y="285" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="689" y="335" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycResult_di" bpmnElement="kycResult">
        <dc:Bounds x="832" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="258" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="kycTimeout_di" bpmnElement="kycTimeout">
        <dc:Bounds x="832" y="362" width="36" height="36" />
