<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="transferDefinitions" name="Token transfer workflows" targetNamespace="https://generalcontracts.ai/workflows" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:message id="transferInstructionMessage" name="TransferInstructionReceived">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=instructionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="transactionResultMessage" name="TransferTransactionResult">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=instructionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="transferCancellationMessage" name="TransferCancellationRequested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=instructionId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_1w3t2zw">
    <bpmn:participant id="Participant_1t8twvl" name="Token transfer" processRef="transfer-lifecycle" />
  </bpmn:collaboration>
  <bpmn:process id="transfer-lifecycle" name="Token transfer lifecycle" isExecutable="true">
    <bpmn:startEvent id="transferReceived" name="Transfer instruction received">
      <bpmn:messageEventDefinition messageRef="transferInstructionMessage" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="validateTransfer" name="Validate transfer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="transfer-validate" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="validationGateway" name="Instruction valid?" default="flowInvalid" />
    <bpmn:endEvent id="validationRejected" name="Validation failed" />
    <bpmn:parallelGateway id="screeningFork" name="Request mandatory screenings" />
    <bpmn:callActivity id="kycScreeningCall" name="KYC screening">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="kyc-screening-process" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=instructionId" target="instructionId" />
          <zeebe:output source="=kycRequestReady" target="kycRequestReady" />
          <zeebe:output source="=kycNotRequired" target="kycNotRequired" />
          <zeebe:output source="=kycScreeningRequestIds" target="kycScreeningRequestIds" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="flowStartValidate" sourceRef="transferReceived" targetRef="validateTransfer" />
    <bpmn:sequenceFlow id="flowValidateGateway" sourceRef="validateTransfer" targetRef="validationGateway" />
    <bpmn:sequenceFlow id="flowInvalid" sourceRef="validationGateway" targetRef="validationRejected">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=validationPassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowValid" sourceRef="validationGateway" targetRef="screeningFork">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowKycRequest" sourceRef="screeningFork" targetRef="kycScreeningCall" />
    <bpmn:sequenceFlow id="flowAmlRequest" sourceRef="screeningFork" targetRef="amlScreeningCall" />
    <bpmn:sequenceFlow id="flowSanctionsRequest" sourceRef="screeningFork" targetRef="sanctionsScreeningCall" />
    <bpmn:sequenceFlow id="flowAmlResultJoin" sourceRef="amlScreeningCall" targetRef="screeningJoin" />
    <bpmn:sequenceFlow id="flowSanctionsResultJoin" sourceRef="sanctionsScreeningCall" targetRef="screeningJoin" />
    <bpmn:sequenceFlow id="flowKycRequestsJoin" sourceRef="kycScreeningCall" targetRef="screeningJoin" />
    <bpmn:sequenceFlow id="flowJoinAggregate" sourceRef="screeningJoin" targetRef="aggregateCompliance" />
    <bpmn:sequenceFlow id="flowAggregateGateway" sourceRef="aggregateCompliance" targetRef="complianceGateway" />
    <bpmn:sequenceFlow id="flowComplianceReject" sourceRef="complianceGateway" targetRef="complianceRejected">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=complianceOutcome = "REJECTED" or complianceOutcome = "HOLD" or complianceOutcome = "RESTRICTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowComplianceReview" sourceRef="complianceGateway" targetRef="manualReview">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=complianceOutcome = "MANUAL_REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowComplianceApproved" sourceRef="complianceGateway" targetRef="revalidateTransfer">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=complianceOutcome = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowRevalidateGateway" sourceRef="revalidateTransfer" targetRef="executionGateway" />
    <bpmn:sequenceFlow id="flowExecutionHeld" sourceRef="executionGateway" targetRef="executionHeld">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=executionAllowed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowExecutionAllowed" sourceRef="executionGateway" targetRef="submitTransfer">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=executionAllowed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowSubmitResult" sourceRef="submitTransfer" targetRef="submissionGateway" />
    <bpmn:sequenceFlow id="flowSubmissionAccepted" sourceRef="submissionGateway" targetRef="transactionResult">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=submissionOutcome = "SUBMITTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowSubmissionUnknown" sourceRef="submissionGateway" targetRef="recoverUnknownSubmission">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=submissionOutcome != "SUBMITTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowReconciliationPending" sourceRef="reconciliationGateway" targetRef="transactionResult">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=reconciliationPending = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowResultReconcile" sourceRef="transactionResult" targetRef="reconcileTransfer" />
    <bpmn:sequenceFlow id="flowReconcileGateway" sourceRef="reconcileTransfer" targetRef="reconciliationGateway" />
    <bpmn:sequenceFlow id="flowReconciliationMismatch" sourceRef="reconciliationGateway" targetRef="reconciliationHeld">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=reconciliationMatched = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowReconciliationMatch" sourceRef="reconciliationGateway" targetRef="transferCompleted">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=reconciliationMatched = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowUnknownRecoveryResult" sourceRef="recoverUnknownSubmission" targetRef="unknownRecoveryGateway" />
    <bpmn:sequenceFlow id="flowUnknownRecoveryHash" sourceRef="unknownRecoveryGateway" targetRef="transactionResult">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=recoveryHasTransactionHash = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flowUnknownRecoveryHold" sourceRef="unknownRecoveryGateway" targetRef="submissionUnknown" />
    <bpmn:exclusiveGateway id="complianceGateway" name="Compliance outcome" default="flowComplianceReject" />
    <bpmn:endEvent id="complianceRejected" name="Compliance rejected or held" />
    <bpmn:serviceTask id="revalidateTransfer" name="Revalidate immediately before execution">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="transfer-pre-execution-gate" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="executionGateway" name="Execution gate passed?" default="flowExecutionHeld" />
    <bpmn:endEvent id="executionHeld" name="Execution held" />
    <bpmn:serviceTask id="submitTransfer" name="Submit token transfer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="transfer-submit" retries="1" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="submissionGateway" name="Submission acknowledged?" default="flowSubmissionUnknown" />
    <bpmn:endEvent id="submissionUnknown" name="Submission outcome unknown or rejected" />
    <bpmn:intermediateCatchEvent id="transactionResult" name="Await transaction result">
      <bpmn:messageEventDefinition messageRef="transactionResultMessage" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="reconcileTransfer" name="Reconcile confirmed transfer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="transfer-reconcile" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="reconciliationGateway" name="Reconciliation matched?" default="flowReconciliationMismatch" />
    <bpmn:endEvent id="reconciliationHeld" name="Reconciliation mismatch" />
    <bpmn:endEvent id="transferCompleted" name="Transfer completed">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=true" target="completionEmitted" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:endEvent>
    <bpmn:serviceTask id="recoverUnknownSubmission" name="Look up journaled payment submission">
      <bpmn:documentation>Lookup the existing instruction-keyed submission journal only. Reconcile through the existing transaction-result path only when a matching known hash exists. Without a journaled hash, keep the transfer operationally held. Never submit again.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="transfer-recover-unknown" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=instructionId" target="instructionId" />
          <zeebe:output source="=recoveryHasTransactionHash" target="recoveryHasTransactionHash" />
          <zeebe:output source="=recoveryRequiresInvestigation" target="recoveryRequiresInvestigation" />
          <zeebe:output source="=recoveryReasonCode" target="recoveryReasonCode" />
          <zeebe:output source="=transactionHash" target="transactionHash" />
          <zeebe:output source="=transactionOutcome" target="transactionOutcome" />
          <zeebe:output source="=finalized" target="finalized" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="unknownRecoveryGateway" name="Journaled transaction hash found?" default="flowUnknownRecoveryHold" />
    <bpmn:callActivity id="amlScreeningCall" name="AML screening">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="aml-screening-process" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=instructionId" target="instructionId" />
          <zeebe:input source="=amlCorrelationKey" target="amlCorrelationKey" />
          <zeebe:output source="=amlRequestReady" target="amlRequestReady" />
          <zeebe:output source="=amlTimeoutPersisted" target="amlTimeoutPersisted" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="screeningJoin" name="All mandatory results received" />
    <bpmn:endEvent id="manualReview" name="Manual review required" />
    <bpmn:callActivity id="sanctionsScreeningCall" name="SANCTIONS screening">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="sanctions-screening-process" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=instructionId" target="instructionId" />
          <zeebe:input source="=sanctionsCorrelationKey" target="sanctionsCorrelationKey" />
          <zeebe:output source="=sanctionsRequestReady" target="sanctionsRequestReady" />
          <zeebe:output source="=sanctionsTimeoutPersisted" target="sanctionsTimeoutPersisted" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:serviceTask id="aggregateCompliance" name="Aggregate compliance decisions">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="compliance-aggregate" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:subProcess id="transferCancellation" name="Handle pre-submission cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="cancellationRequested" name="Cancellation requested" isInterrupting="false">
        <bpmn:messageEventDefinition messageRef="transferCancellationMessage" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="cancelTransfer" name="Cancel transfer before submission">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="transfer-cancel" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=instructionId" target="instructionId" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="cancellationGateway" name="Cancellation accepted?" default="flowCancellationRejected" />
      <bpmn:endEvent id="cancellationHandled" name="Cancellation handled" />
      <bpmn:endEvent id="cancellationTerminated" name="Cancel transfer process">
        <bpmn:terminateEventDefinition />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flowCancellationRequested" sourceRef="cancellationRequested" targetRef="cancelTransfer" />
      <bpmn:sequenceFlow id="flowCancelResult" sourceRef="cancelTransfer" targetRef="cancellationGateway" />
      <bpmn:sequenceFlow id="flowCancellationAccepted" sourceRef="cancellationGateway" targetRef="cancellationTerminated">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=cancellationOutcome = "CANCELLED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="flowCancellationRejected" sourceRef="cancellationGateway" targetRef="cancellationHandled" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_transfer-lifecycle">
    <bpmndi:BPMNPlane id="BPMNPlane_transfer-lifecycle" bpmnElement="Collaboration_1w3t2zw">
