            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsTimeoutJoin" id="flowSanctionsTimeoutJoin_di">
                <di:waypoint x="880" y="348"/>
                <di:waypoint x="930" y="348"/>
                <di:waypoint x="930" y="243"/>
                <di:waypoint x="980" y="243"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsPolicyHoldJoin" id="flowSanctionsPolicyHoldJoin_di">
                <di:waypoint x="640" y="510"/>
