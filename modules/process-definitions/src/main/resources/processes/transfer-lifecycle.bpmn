            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsResultJoin" id="flowSanctionsResultJoin_di">
                <di:waypoint x="686" y="138"/>
                <di:waypoint x="900" y="138"/>
                <di:waypoint x="900" y="243"/>
                <di:waypoint x="980" y="243"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsTimeoutPersist" id="flowSanctionsTimeoutPersist_di">
                <di:waypoint x="686" y="348"/>
