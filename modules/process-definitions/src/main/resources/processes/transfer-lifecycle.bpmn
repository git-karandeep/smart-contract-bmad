<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" exporter="Camunda Modeler" exporterVersion="5.48.0" id="transferDefinitions" name="Token transfer workflows" targetNamespace="https://generalcontracts.ai/workflows">
    <bpmn:message id="sanctionsResultMessage" name="SanctionsScreeningResult">
            
        <bpmn:extensionElements>
                  
            <zeebe:subscription correlationKey="=sanctionsCorrelationKey"/>
                
        </bpmn:extensionElements>
          
    </bpmn:message>
    <bpmn:process id="sanctions-screening-process" isExecutable="true" name="SANCTIONS screening">
        <bpmn:documentation>Contract v1.0.0. Inputs: instructionId, sanctionsCorrelationKey. Outputs: sanctionsRequestReady, sanctionsTimeoutPersisted. Outcome codes: APPROVED, REJECTED, MANUAL_REVIEW, RESTRICTED, ERROR, TIMED_OUT, HOLD. The instruction-keyed persisted screening requests and results are authoritative; timeout, missing, and exhausted technical outcomes remain fail-closed. Correlation is preserved by the declared screening message subscription. Deploy compatible revisions under this stable process ID and use Camunda's process version.</bpmn:documentation>
        <bpmn:startEvent id="sanctionsStart" name="Start SANCTIONS screening"/>
        <bpmn:serviceTask id="requestSanctions" name="Request sanctions screening">
                  
            <bpmn:extensionElements>
                        
                <zeebe:taskDefinition retries="3" type="screening-request-sanctions"/>
                      
            </bpmn:extensionElements>
                
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway default="flowSanctionsPolicyHold" id="sanctionsRequestGateway" name="Sanctions request published?"/>
        <bpmn:eventBasedGateway id="sanctionsWait" name="Await sanctions result or timeout"/>
        <bpmn:intermediateCatchEvent id="sanctionsResult" name="Sanctions result">
                  
            <bpmn:messageEventDefinition messageRef="sanctionsResultMessage"/>
                
        </bpmn:intermediateCatchEvent>
        <bpmn:intermediateCatchEvent id="sanctionsTimeout" name="Sanctions timeout">
                  
            <bpmn:timerEventDefinition>
                        
                <bpmn:timeDuration>PT15M</bpmn:timeDuration>
                      
            </bpmn:timerEventDefinition>
                
        </bpmn:intermediateCatchEvent>
        <bpmn:serviceTask id="sanctionsTimeoutPersist" name="Persist sanctions timeout hold">
                  
            <bpmn:extensionElements>
                        
                <zeebe:taskDefinition retries="3" type="screening-timeout-sanctions"/>
                      
            </bpmn:extensionElements>
                
        </bpmn:serviceTask>
        <bpmn:serviceTask id="sanctionsPolicyHold" name="Persist missing sanctions policy hold">
                  
            <bpmn:extensionElements>
                        
                <zeebe:taskDefinition retries="3" type="screening-timeout-sanctions"/>
                      
            </bpmn:extensionElements>
                
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="sanctionsStartFlow" sourceRef="sanctionsStart" targetRef="requestSanctions"/>
        <bpmn:sequenceFlow id="flowSanctionsRequestGateway" sourceRef="requestSanctions" targetRef="sanctionsRequestGateway"/>
        <bpmn:sequenceFlow id="flowSanctionsRequestPublished" sourceRef="sanctionsRequestGateway" targetRef="sanctionsWait">
                  
            <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=sanctionsRequestReady = true</bpmn:conditionExpression>
                
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flowSanctionsPolicyHold" sourceRef="sanctionsRequestGateway" targetRef="sanctionsPolicyHold">
                  
            <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=sanctionsRequestReady = false</bpmn:conditionExpression>
                
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="flowSanctionsResult" sourceRef="sanctionsWait" targetRef="sanctionsResult"/>
        <bpmn:sequenceFlow id="flowSanctionsTimeout" sourceRef="sanctionsWait" targetRef="sanctionsTimeout"/>
        <bpmn:sequenceFlow id="flowSanctionsResultJoin" sourceRef="sanctionsResult" targetRef="sanctionsEnd"/>
        <bpmn:sequenceFlow id="flowSanctionsTimeoutPersist" sourceRef="sanctionsTimeout" targetRef="sanctionsTimeoutPersist"/>
        <bpmn:sequenceFlow id="flowSanctionsTimeoutJoin" sourceRef="sanctionsTimeoutPersist" targetRef="sanctionsEnd"/>
        <bpmn:sequenceFlow id="flowSanctionsPolicyHoldJoin" sourceRef="sanctionsPolicyHold" targetRef="sanctionsEnd"/>
        <bpmn:endEvent id="sanctionsEnd" name="SANCTIONS outcome persisted"/>
    </bpmn:process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_sanctions-screening-process">
        <bpmndi:BPMNPlane bpmnElement="sanctions-screening-process" id="BPMNPlane_sanctions-screening-process">
            <bpmndi:BPMNShape bpmnElement="sanctionsStart" id="sanctionsStart_di">
                <dc:Bounds height="36" width="36" x="100" y="220"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="requestSanctions" id="requestSanctions_di">
                <dc:Bounds height="80" width="120" x="200" y="198"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="sanctionsRequestGateway" id="sanctionsRequestGateway_di" isMarkerVisible="true">
