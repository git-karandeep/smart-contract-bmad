                <dc:Bounds height="36" width="36" x="650" y="330"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="sanctionsTimeoutPersist" id="sanctionsTimeoutPersist_di">
                <dc:Bounds height="80" width="120" x="760" y="308"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="sanctionsPolicyHold" id="sanctionsPolicyHold_di">
                <dc:Bounds height="80" width="120" x="520" y="470"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="sanctionsEnd" id="sanctionsEnd_di">
                <dc:Bounds height="36" width="36" x="980" y="225"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="sanctionsStartFlow" id="sanctionsStartFlow_di">
                <di:waypoint x="136" y="238"/>
                <di:waypoint x="200" y="238"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsRequestGateway" id="flowSanctionsRequestGateway_di">
                <di:waypoint x="320" y="238"/>
                <di:waypoint x="390" y="238"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsRequestPublished" id="flowSanctionsRequestPublished_di">
                <di:waypoint x="440" y="238"/>
                <di:waypoint x="520" y="238"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsPolicyHold" id="flowSanctionsPolicyHold_di">
                <di:waypoint x="415" y="263"/>
                <di:waypoint x="415" y="510"/>
                <di:waypoint x="520" y="510"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsResult" id="flowSanctionsResult_di">
                <di:waypoint x="545" y="213"/>
                <di:waypoint x="545" y="138"/>
                <di:waypoint x="650" y="138"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowSanctionsTimeout" id="flowSanctionsTimeout_di">
